{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'lookbook.css' | asset_url | stylesheet_tag }}

{% render 'lookbook-styles',
  section_id: section.id,
  background: section.settings.background,
  heading_color: section.settings.heading_color,
  text_color: section.settings.text_color,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{%- liquid
  assign lookbook = section.settings.lookbook
  if lookbook == blank
    assign lookbook = metaobjects.lookbook.values | first
  endif

  assign lookbooks = nil
  if lookbook != blank
    assign lookbooks = lookbook.system.handle | split: ','
  endif
-%}

<div class="lookbook-section">
  <div class="page-width">
    {%- if lookbook == blank -%}
      <p>{{ 'sections.lookbook.empty' | t }}</p>
    {%- endif -%}
    {% render 'lookbook-island', lookbooks: lookbooks, section_id: section.id %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.lookbook.name",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "metaobject",
      "id": "lookbook",
      "label": "t:sections.lookbook.settings.lookbook.label",
      "info": "t:sections.lookbook.settings.lookbook.info",
      "metaobject_type": "lookbook"
    },
    {
      "type": "header",
      "content": "t:sections.lookbook.settings.colors.content"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:sections.lookbook.settings.background.label"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:sections.lookbook.settings.heading_color.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.lookbook.settings.text_color.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.lookbook.presets.name"
    }
  ]
}
{% endschema %}
