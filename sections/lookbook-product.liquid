{%- liquid
  assign max_lookbooks = 2
  assign matched_count = 0
  assign matched_handles = ''
  assign lookbook_handles = nil
-%}

{%- for entry in metaobjects.lookbook.values -%}
  {%- capture product_handles -%}

    {% render 'lookbook-product-handles', products: entry.products.value %}
    
  {%- endcapture -%}
  {%- assign product_handles = product_handles | strip -%}

  {%- if product_handles != blank -%}
    {%- assign entry_product_handles = product_handles | split: ',' -%}

    {%- if entry_product_handles contains product.handle -%}

      {%- if matched_handles != blank -%}
        {%- assign matched_handles = matched_handles | append: ',' -%}
      {%- endif -%}

      {%- assign matched_handles = matched_handles | append: entry.system.handle -%}

      {%- assign matched_count = matched_count | plus: 1 -%}

      {%- if matched_count >= max_lookbooks -%}
        {%- break -%}
      {%- endif -%}

    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- if matched_count > 0 -%}
  {%- assign lookbook_handles = matched_handles | split: ',' -%}
{%- endif -%}

{%- if matched_count > 0 -%}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'lookbook.css' | asset_url | stylesheet_tag }}

  {% render 'lookbook-styles',
    section_id: section.id,
    background: section.settings.background,
    heading_color: section.settings.heading_color,
    text_color: section.settings.text_color,
    padding_top: section.settings.padding_top,
    padding_bottom: section.settings.padding_bottom
  %}

  <div class="lookbook-section">
    <div class="page-width">
      {% render 'lookbook-island',
        lookbooks: lookbook_handles,
        section_id: section.id
      %}
    </div>
  </div>
{%- endif -%}

{% schema %}
  {
    "name": "t:sections.lookbook-product.name",
    "enabled_on": {
      "templates": ["product"]
    },
    "settings": [
      {
        "type": "paragraph",
        "content": "t:sections.lookbook-product.settings.paragraph.content"
      },
      {
        "type": "header",
        "content": "t:sections.lookbook.settings.colors.content"
      },
      {
        "type": "color",
        "id": "background",
        "label": "t:sections.lookbook.settings.background.label"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "t:sections.lookbook.settings.heading_color.label"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "t:sections.lookbook.settings.text_color.label"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "t:sections.lookbook-product.presets.name"
      }
    ]
  }
{% endschema %}